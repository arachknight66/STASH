generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  REFUND
}

enum AccountType {
  CASH
  WALLET
  SAVINGS
  SPENDING
  CREDIT_CARD_MANUAL
  SHARED_POOL
  EMERGENCY_FUND
  OTHER
}

enum BudgetScope {
  OVERALL
  CATEGORY
}

enum BillingCycle {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  CUSTOM
}

enum BillStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELED
  TRIAL
}

enum BucketTheme {
  PRIMARY
  SECONDARY
  TERTIARY
  NEUTRAL
}

enum NotificationType {
  BUCKET_MILESTONE
  BUDGET_ALERT
  PAYDAY
  GENERAL
}

enum Currency {
  USD
  EUR
  INR
  GBP
}

// ─── Models ──────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  passwordHash String?
  name        String
  initials    String   @db.VarChar(4)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions  Transaction[]
  buckets       Bucket[]
  notifications Notification[]
  settings      Settings?
  accounts      Account[]
  budgets       Budget[]
  bills         Bill[]
  subscriptions Subscription[]
}

model Account {
  id             String      @id @default(cuid())
  userId         String
  name           String
  type           AccountType
  description    String?
  openingBalance Float       @default(0)
  currentBalance Float       @default(0)
  currency       Currency    @default(USD)
  colorTheme     String?     // hex color or theme token
  icon           String?     // icon identifier
  isArchived     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions   Transaction[] @relation("AccountTransactions")
  transfers      Transaction[] @relation("CounterpartyTransactions")

  @@index([userId])
}

model Transaction {
  id                    String              @id @default(cuid())
  userId                String
  accountId             String?
  counterpartyAccountId String?
  merchant              String
  amount                Float               // always stored in USD/base currency
  type                  TransactionType
  category              String
  subCategory           String?
  note                  String?
  aiInsight             String?
  tags                  String[]
  createdAt             DateTime            @default(now())
  occurredAt            DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  source                String              @default("MANUAL") // MANUAL, SYSTEM, SUBSCRIPTION, BILL
  status                String              @default("POSTED") // POSTED, PENDING
  isRecurringCandidate  Boolean             @default(false)
  linkedSubscriptionId  String?
  linkedBillId          String?

  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  account               Account?            @relation("AccountTransactions", fields: [accountId], references: [id], onDelete: Cascade)
  counterpartyAccount   Account?            @relation("CounterpartyTransactions", fields: [counterpartyAccountId], references: [id], onDelete: SetNull)
  subscription          Subscription?       @relation(fields: [linkedSubscriptionId], references: [id], onDelete: SetNull)
  bill                  Bill?               @relation(fields: [linkedBillId], references: [id], onDelete: SetNull)

  @@index([userId, occurredAt(sort: Desc)])
  @@index([userId, category])
  @@index([accountId])
}

model Budget {
  id               String      @id @default(cuid())
  userId           String
  name             String
  scope            BudgetScope
  category         String?
  amount           Float
  period           String      @default("MONTHLY")
  startDay         Int         @default(1)
  alertThresholdPct Float       @default(80.0)
  isActive         Boolean     @default(true)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Bill {
  id                 String       @id @default(cuid())
  userId             String
  name               String
  category           String
  amountExpected     Float?
  amountLastPaid     Float?
  accountId          String?
  billingCycle       BillingCycle
  nextDueDate        DateTime
  autopay            Boolean      @default(false)
  status             BillStatus   @default(ACTIVE)
  reminderDaysBefore Int          @default(3)
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions       Transaction[]

  @@index([userId])
}

model Subscription {
  id                String             @id @default(cuid())
  userId            String
  name              String
  provider          String
  category          String
  amount            Float
  currency          Currency           @default(USD)
  billingCycle      BillingCycle
  nextBillingDate   DateTime
  lastChargedAt     DateTime?
  status            SubscriptionStatus @default(ACTIVE)
  autopay           Boolean            @default(false)
  accountId         String?
  merchantMatchRule String?
  notes             String?
  icon              String?
  colorTheme        String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions      Transaction[]

  @@index([userId])
}

model Bucket {
  id          String      @id @default(cuid())
  userId      String
  name        String
  subtitle    String
  targetUsd   Float
  savedUsd    Float       @default(0)
  monthlyUsd  Float       @default(0)
  icon        String
  theme       BucketTheme @default(PRIMARY)
  isFeatured  Boolean     @default(false)
  isNew       Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  link      String?          // e.g. "buckets"
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model Settings {
  id           String   @id @default(cuid())
  userId       String   @unique
  darkMode     Boolean  @default(false)
  currency     Currency @default(USD)
  pushNotifs   Boolean  @default(true)
  budgetAlerts Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
